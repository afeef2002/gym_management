 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n    @page {\n        size: A4;\n        margin: 15mm;\n    }\n\n    body {\n        font-family: Arial, sans-serif;\n        color: #222;\n        font-size: 12px;\n    }\n\n    .invoice-container {\n        max-width: 850px;\n        margin: auto;\n        padding: 20px;\n    }\n\n    .header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        border-bottom: 3px solid #222;\n        padding-bottom: 18px;\n    }\n\n    .gym-name {\n        font-size: 27px;\n        font-weight: bold;\n        color: #171717;\n    }\n\n    .gym-tagline {\n        color: #777;\n        margin-top: 5px;\n    }\n\n    .document-title {\n        text-align: right;\n    }\n\n    .document-title h2 {\n        margin: 0;\n        font-size: 21px;\n        color: #d97706;\n    }\n\n    .document-title p {\n        color: #777;\n    }\n\n    .section {\n        margin-top: 25px;\n    }\n\n    .section-title {\n        background: #222;\n        color: white;\n        padding: 10px;\n        font-size: 13px;\n        font-weight: bold;\n        margin-bottom: 12px;\n    }\n\n    .details-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 15px;\n    }\n\n    .detail {\n        padding: 8px 0;\n        border-bottom: 1px solid #eee;\n    }\n\n    .label {\n        color: #777;\n        font-size: 10px;\n        text-transform: uppercase;\n        display: block;\n        margin-bottom: 5px;\n    }\n\n    .value {\n        font-size: 13px;\n        font-weight: bold;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 10px;\n    }\n\n    th {\n        background: #333;\n        color: white;\n        padding: 11px;\n        text-align: left;\n    }\n\n    td {\n        padding: 11px;\n        border-bottom: 1px solid #ddd;\n    }\n\n    .amount-summary {\n        width: 48%;\n        margin-left: auto;\n        margin-top: 20px;\n    }\n\n    .amount-summary td {\n        padding: 9px;\n    }\n\n    .total-row {\n        background: #222;\n        color: white;\n        font-weight: bold;\n        font-size: 15px;\n    }\n\n    .status {\n        display: inline-block;\n        padding: 6px 12px;\n        border-radius: 4px;\n        font-weight: bold;\n        font-size: 11px;\n    }\n\n    .paid {\n        background: #dcfce7;\n        color: #166534;\n    }\n\n    .pending {\n        background: #fef3c7;\n        color: #92400e;\n    }\n\n    .expired {\n        background: #fee2e2;\n        color: #991b1b;\n    }\n\n    .footer {\n        margin-top: 50px;\n        border-top: 1px solid #ddd;\n        padding-top: 20px;\n        text-align: center;\n        color: #777;\n    }\n\n    .signature {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 55px;\n    }\n\n    .signature div {\n        width: 200px;\n        border-top: 1px solid #333;\n        padding-top: 8px;\n        text-align: center;\n    }\n\n    @media print {\n        body {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n\n        .invoice-container {\n            padding: 0;\n        }\n    }\n</style>\n\n<div class=\"invoice-container\">\n\n    <!-- HEADER -->\n\n    <div class=\"header\">\n        <div>\n            <div class=\"gym-name\">FITZONE GYM</div>\n            <div class=\"gym-tagline\">\n                Fitness \u2022 Strength \u2022 Lifestyle\n            </div>\n            <p>\n                Member Billing & Subscription Management\n            </p>\n        </div>\n\n        <div class=\"document-title\">\n            <h2>BILLING SUMMARY</h2>\n            <p>\n                Invoice: {{ doc.name }}\n            </p>\n            <p>\n                Date: {{ frappe.utils.formatdate(doc.get(\"posting_date\") or doc.get(\"creation\")) }}\n            </p>\n        </div>\n    </div>\n\n\n    <!-- MEMBER DETAILS -->\n\n    <div class=\"section\">\n\n        <div class=\"section-title\">\n            MEMBER INFORMATION\n        </div>\n\n        <div class=\"details-grid\">\n\n            <div class=\"detail\">\n                <span class=\"label\">Member Name</span>\n                <span class=\"value\">\n                    {{ doc.get(\"member_name\") or doc.get(\"customer_name\") or doc.get(\"member\") or \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Member ID</span>\n                <span class=\"value\">\n                    {{ doc.get(\"member\") or doc.get(\"customer\") or \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Email Address</span>\n                <span class=\"value\">\n                    {{ doc.get(\"email\") or doc.get(\"email_id\") or \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Phone Number</span>\n                <span class=\"value\">\n                    {{ doc.get(\"phone\") or doc.get(\"mobile_no\") or \"-\" }}\n                </span>\n            </div>\n\n        </div>\n    </div>\n\n\n    <!-- SUBSCRIPTION DETAILS -->\n\n    <div class=\"section\">\n\n        <div class=\"section-title\">\n            SUBSCRIPTION DETAILS\n        </div>\n\n        <div class=\"details-grid\">\n\n            <div class=\"detail\">\n                <span class=\"label\">Membership Plan</span>\n                <span class=\"value\">\n                    {{ doc.get(\"membership_plan\") or doc.get(\"plan\") or \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Subscription Status</span>\n                <span class=\"value\">\n                    {{ doc.get(\"status\") or \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Start Date</span>\n                <span class=\"value\">\n                    {{ frappe.utils.formatdate(doc.get(\"start_date\")) if doc.get(\"start_date\") else \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Expiry Date</span>\n                <span class=\"value\">\n                    {{ frappe.utils.formatdate(doc.get(\"end_date\")) if doc.get(\"end_date\") else \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Duration</span>\n                <span class=\"value\">\n                    {{ doc.get(\"duration\") or \"-\" }}\n                </span>\n            </div>\n\n            <div class=\"detail\">\n                <span class=\"label\">Payment Method</span>\n                <span class=\"value\">\n                    {{ doc.get(\"payment_method\") or \"-\" }}\n                </span>\n            </div>\n\n        </div>\n    </div>\n\n\n    <!-- BILLING DETAILS -->\n\n    <div class=\"section\">\n\n        <div class=\"section-title\">\n            BILLING INFORMATION\n        </div>\n\n        <table>\n            <thead>\n                <tr>\n                    <th>Description</th>\n                    <th>Amount</th>\n                </tr>\n            </thead>\n\n            <tbody>\n                <tr>\n                    <td>Membership Subscription</td>\n                    <td>\n                        {{ frappe.utils.fmt_money(doc.get(\"total_amount\") or doc.get(\"grand_total\") or 0, currency=doc.get(\"currency\")) }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td>Discount</td>\n                    <td>\n                        {{ frappe.utils.fmt_money(doc.get(\"discount_amount\") or 0, currency=doc.get(\"currency\")) }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td>Tax</td>\n                    <td>\n                        {{ frappe.utils.fmt_money(doc.get(\"tax_amount\") or 0, currency=doc.get(\"currency\")) }}\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n\n\n        <!-- PAYMENT SUMMARY -->\n\n        <table class=\"amount-summary\">\n\n            <tr>\n                <td>Total Amount</td>\n                <td>\n                    {{ frappe.utils.fmt_money(doc.get(\"grand_total\") or doc.get(\"total_amount\") or 0, currency=doc.get(\"currency\")) }}\n                </td>\n            </tr>\n\n            <tr>\n                <td>Amount Paid</td>\n                <td>\n                    {{ frappe.utils.fmt_money(doc.get(\"paid_amount\") or 0, currency=doc.get(\"currency\")) }}\n                </td>\n            </tr>\n\n            <tr>\n                <td>Outstanding Balance</td>\n                <td>\n                    {{ frappe.utils.fmt_money(doc.get(\"outstanding_amount\") or 0, currency=doc.get(\"currency\")) }}\n                </td>\n            </tr>\n\n            <tr class=\"total-row\">\n                <td>PAYMENT STATUS</td>\n                <td>\n                    {{ doc.get(\"payment_status\") or \"Not specified\" }}\n                </td>\n            </tr>\n\n        </table>\n\n    </div>\n\n\n    <!-- PAYMENT HISTORY -->\n\n    {% if doc.get(\"payment_history\") %}\n\n    <div class=\"section\">\n\n        <div class=\"section-title\">\n            PAYMENT HISTORY\n        </div>\n\n        <table>\n            <thead>\n                <tr>\n                    <th>Payment Date</th>\n                    <th>Reference</th>\n                    <th>Payment Method</th>\n                    <th>Amount</th>\n                </tr>\n            </thead>\n\n            <tbody>\n\n                {% for payment in doc.get(\"payment_history\") %}\n\n                <tr>\n                    <td>\n                        {{ frappe.utils.formatdate(payment.payment_date) if payment.payment_date else \"-\" }}\n                    </td>\n\n                    <td>\n                        {{ payment.reference or \"-\" }}\n                    </td>\n\n                    <td>\n                        {{ payment.payment_method or \"-\" }}\n                    </td>\n\n                    <td>\n                        {{ frappe.utils.fmt_money(payment.amount or 0, currency=doc.get(\"currency\")) }}\n                    </td>\n                </tr>\n\n                {% endfor %}\n\n            </tbody>\n        </table>\n\n    </div>\n\n    {% endif %}\n\n\n    <!-- SIGNATURE -->\n\n    <div class=\"signature\">\n\n        <div>\n            Member Signature\n        </div>\n\n        <div>\n            Authorized Signature\n        </div>\n\n    </div>\n\n\n    <!-- FOOTER -->\n\n    <div class=\"footer\">\n\n        <h3>Thank You for Choosing FitZone Gym!</h3>\n\n        <p>\n            Stay Strong. Stay Healthy. Keep Moving.\n        </p>\n\n        <p>\n            This document is generated electronically by FitZone Gym.\n        </p>\n\n        <p>\n            \u00a9 2026 FitZone Gym. All Rights Reserved.\n        </p>\n\n    </div>\n\n</div>",
